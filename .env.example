# ============================================================
# Sourcerer — environment variables
# A hybrid RAG knowledge assistant that answers with sources.
# Copy this file to `.env` and fill in real values.
# `.env` must be gitignored — never commit real secrets.
# ============================================================

# ---------- App ----------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Database (Postgres + pgvector) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sourcerer
POSTGRES_USER=sourcerer
POSTGRES_PASSWORD=change_me         # set a real password locally
# Full connection string (used by the app; keep in sync with the values above)
DATABASE_URL=postgresql://sourcerer:change_me@localhost:5432/sourcerer

# ---------- Local inference: Ollama (Phases 1–4) ----------
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:32b             # the local generation model
# Embedding model served locally (used for ingestion + query embedding)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024                  # must match the model; bge-m3 = 1024

# ---------- Local inference: vLLM (Phase 5, when you migrate) ----------
# vLLM exposes an OpenAI-compatible API; leave blank until Phase 5.
VLLM_BASE_URL=
VLLM_MODEL=

# ---------- Frontier API model (the "hard query" route) ----------
# Fill in whichever provider you use for the API route.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which API model the router calls for hard queries
API_MODEL=claude-sonnet-4-20250514

# ---------- Reranker (Phase 2) ----------
# Set to "local" to use a self-hosted bge-reranker, or "cohere" for the API.
RERANKER_TYPE=local                 # local | cohere
RERANKER_MODEL=bge-reranker-v2-m3
COHERE_API_KEY=                     # only needed if RERANKER_TYPE=cohere

# ---------- Chunking ----------
CHUNK_STRATEGY=fixed                # fixed | semantic
CHUNK_SIZE=512                      # approx words per chunk
CHUNK_OVERLAP=64                    # used by the fixed strategy
SEMANTIC_THRESHOLD=0.5             # similarity break point for the semantic strategy

# ---------- Retrieval config ----------
RETRIEVAL_MODE=hybrid               # hybrid | vector  (vector = the Phase 1 path)
TOP_K_VECTOR=20                     # candidates from vector search
TOP_K_BM25=20                       # candidates from keyword search
TOP_K_FINAL=5                       # chunks passed to the model after reranking
RRF_K=60                            # reciprocal rank fusion constant

# ---------- Router (Phase 4) ----------
# How the router decides local vs API. Tune as you measure.
ROUTER_STRATEGY=heuristic           # heuristic | classifier
# Treat queries above this estimated difficulty as "hard" → API route
ROUTER_HARD_THRESHOLD=0.7

# ---------- Evaluation (Phase 3) ----------
EVAL_SET_PATH=eval/eval_set.jsonl
EVAL_CORPUS_PATH=eval/corpus      # synthetic corpus the runner ingests for reproducibility
# LLM used as judge for faithfulness / answer relevancy. A local model keeps eval
# offline/reproducible now; swap for a frontier model once the API route exists.
EVAL_JUDGE_MODEL=qwen2.5:7b

# ---------- GraphRAG (Phase 6, optional) ----------
GRAPHRAG_ENABLED=false
# Use the local model for graph extraction to control indexing cost.
GRAPHRAG_EXTRACTION_MODEL=qwen2.5:32b
GRAPHRAG_ROOT=./graphrag

# ---------- Observability (Phase 5) ----------
# Optional: wire up a tracing/observability backend if you use one.
ENABLE_TRACING=false
TRACING_ENDPOINT=
