# ============================================================
# Sourcerer — environment variables
# A hybrid RAG knowledge assistant that answers with sources.
# Copy this file to `.env` and fill in real values.
# `.env` must be gitignored — never commit real secrets.
# ============================================================

# ---------- App ----------
APP_ENV=development                 # development | production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Database (Postgres + pgvector) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sourcerer
POSTGRES_USER=sourcerer
POSTGRES_PASSWORD=change_me         # set a real password locally
# Full connection string (used by the app; keep in sync with the values above)
DATABASE_URL=postgresql://sourcerer:change_me@localhost:5432/sourcerer

# ---------- Local inference ----------
# Generation backend for the local route: ollama (dev) or vllm (prod).
# Embeddings always run on Ollama (bge-m3) regardless of this.
LOCAL_BACKEND=ollama                # ollama | vllm
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:32b             # the local generation model
# Embedding model served locally (used for ingestion + query embedding)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024                  # must match the model; bge-m3 = 1024

# ---------- Local inference: vLLM (Phase 5) ----------
# vLLM exposes an OpenAI-compatible API. Set LOCAL_BACKEND=vllm to use it.
VLLM_BASE_URL=                      # e.g. http://localhost:8001
VLLM_MODEL=                         # the model id vLLM was launched with

# ---------- Frontier API model (the "hard query" route) ----------
# Uses the Anthropic Messages API. ANTHROPIC_BASE_URL can point at a gateway/proxy
# (Anthropic-compatible); leave blank to hit the public Anthropic API directly.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Which API model the router calls for hard queries (see src/sourcerer/routing/pricing.py).
# Public id e.g. claude-sonnet-4-6, or a gateway alias e.g. codesmart.claude.sonnet.
API_MODEL=claude-sonnet-4-6

# ---------- Reranker (Phase 2) ----------
# none = keep fused order. local = self-hosted cross-encoder. cohere = API. llm = local LLM.
RERANKER_TYPE=none                  # none | local | cohere | llm
# For "local" on CPU, use a SMALL cross-encoder — it adds only ~10-15ms/query:
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# bge-reranker-v2-m3 ranks best (see README eval) but its 568M size is too slow on
# CPU (tens of seconds/query) — only use it with a GPU. Note: Apple MPS is avoided
# (it deadlocks on this torch build); the local reranker runs on CPU/CUDA.
COHERE_API_KEY=                     # only needed if RERANKER_TYPE=cohere

# ---------- Chunking ----------
CHUNK_STRATEGY=fixed                # fixed | semantic
CHUNK_SIZE=512                      # approx words per chunk
CHUNK_OVERLAP=64                    # used by the fixed strategy
SEMANTIC_THRESHOLD=0.5             # similarity break point for the semantic strategy

# ---------- Retrieval config ----------
RETRIEVAL_MODE=hybrid               # hybrid | vector  (vector = the Phase 1 path)
TOP_K_VECTOR=20                     # candidates from vector search
TOP_K_BM25=20                       # candidates from keyword search
TOP_K_FINAL=5                       # chunks passed to the model after reranking
RRF_K=60                            # reciprocal rank fusion constant

# ---------- Router (Phase 4) ----------
# How the router decides local vs API. Tune as you measure.
ROUTER_STRATEGY=heuristic           # heuristic | classifier
# Treat queries above this estimated difficulty as "hard" → API route
ROUTER_HARD_THRESHOLD=0.7

# ---------- Guardrails (Phase 5) ----------
ENABLE_INJECTION_CHECK=true         # reject obvious prompt-injection inputs (400)
# Optional relevance floor: when a cross-encoder reranker ran and the top chunk
# scores below this, treat as "no relevant context" → answer "I don't know".
# Leave unset to disable (empty-context guardrail still always applies).
# MIN_RELEVANCE_SCORE=0.0

# ---------- Evaluation (Phase 3) ----------
EVAL_SET_PATH=eval/eval_set.jsonl
EVAL_CORPUS_PATH=eval/corpus      # synthetic corpus the runner ingests for reproducibility
# LLM used as judge for faithfulness / answer relevancy. A local model keeps eval
# offline/reproducible now; swap for a frontier model once the API route exists.
EVAL_JUDGE_MODEL=qwen2.5:7b

# ---------- GraphRAG (Phase 6, optional) ----------
# Parallel graph-retrieval path for whole-corpus "overview" questions.
# Gated off by default; build the index first (scripts/graphrag_index.py — expensive).
GRAPHRAG_ENABLED=false
# Use the LOCAL model for graph extraction to keep whole-corpus indexing free.
GRAPHRAG_EXTRACTION_MODEL=qwen2.5:32b
# Use the frontier API model for extraction + summaries instead (costs tokens per
# chunk). Only for content a small local model can't structure — e.g. Thai/OCR text
# it summarizes in prose instead of emitting the ENTITY| format. Keep the corpus tiny.
GRAPHRAG_EXTRACT_WITH_API=false
GRAPHRAG_ROOT=./graphrag
GRAPHRAG_OVERVIEW_EVAL_SET=eval/overview_eval_set.jsonl
# Graph storage backend. json = one file loaded per query (simple, small corpora).
# postgres = tables + pgvector; global search ranks communities by similarity to the
# query (not size) and fetches only the relevant few — the production path.
GRAPHRAG_STORE=json                 # json | postgres
# Send only the final global-search reduce (synthesis) to the frontier API model;
# the many cheap map calls + indexing stay local. Needs ANTHROPIC_API_KEY.
GRAPHRAG_REDUCE_WITH_API=false
# Rebuild the graph in the background after a source is deleted: drop communities
# whose source files are all gone, trim deleted files from the rest (by source name,
# not chunk id). Cheap — no re-extraction, no LLM. (A full re-index is still needed
# to fold in *new* documents or re-cluster from scratch.)
GRAPHRAG_REINDEX_ON_DELETE=false

# ---------- Observability (Phase 5) ----------
# Optional: wire up a tracing/observability backend if you use one.
ENABLE_TRACING=false
TRACING_ENDPOINT=
